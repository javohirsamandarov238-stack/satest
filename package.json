{
  "name": "sat-rw-practice",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "standalone": "vite build && node build-standalone.mjs",
    "standalone:flat": "vite build && node build-standalone.mjs flat",
